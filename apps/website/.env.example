# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB used by Payload CMS (the portal itself)
DATABASE_URL=mongodb://127.0.0.1:27017/tkams-website

# ─── Payload CMS ───────────────────────────────────────────────────────────────
# Payload secret key (min 32 chars) — generate: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of this portal (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://tkams.com

# Secret for Vercel Live Preview (optional)
PREVIEW_SECRET=

# Secret for Payload jobs endpoint — protects /api/payload/jobs/run
CRON_SECRET=

# ─── Dokploy provisioning ──────────────────────────────────────────────────────
# URL of your Dokploy instance (e.g. https://deploy.tkams.com)
DOKPLOY_URL=https://deploy.tkams.com

# Dokploy API key (Settings → API Keys in Dokploy UI)
DOKPLOY_API_KEY=YOUR_DOKPLOY_API_KEY

# Combined Docker image (backend + frontend) deployed for each client instance.
# The tag is overridden by the "Deploy Settings" global in Payload admin.
# Build: docker build -f Dockerfile.full -t ghcr.io/yvan2xero/tkams .
DOKPLOY_APP_IMAGE=ghcr.io/yvan2xero/tkams:latest

# Base domain for client subdomains: {subdomain}.tkams.com
TKAMS_BASE_DOMAIN=tkams.com
NEXT_PUBLIC_TKAMS_BASE_DOMAIN=tkams.com

# Public URL of this portal — used to build seed download URLs sent to containers.
# Must be reachable from the Dokploy network.
WEBSITE_URL=https://tkams.com

# ─── Email ─────────────────────────────────────────────────────────────────────
# Sender address for all system emails (verification, password reset…)
EMAIL_FROM=noreply@tkams.com

# Option A — Resend (used when RESEND_API_KEY is set)
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_...

# Option B — SMTP via nodemailer (fallback when RESEND_API_KEY is not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── GHCR (image versions) ─────────────────────────────────────────────────────
# Used by /api/admin/versions to list available image tags.
# Defaults are yvan2xero/tkams — change only if you fork the repo.
GHCR_IMAGE_OWNER=yvan2xero
GHCR_IMAGE_NAME=tkams

# ─── NotchPay ──────────────────────────────────────────────────────────────────
NOTCHPAY_PUBLIC_KEY=pk_...
NOTCHPAY_HASH_KEY=YOUR_NOTCHPAY_HASH_KEY
# Base URL (optional — defaults to https://api.notchpay.co)
NOTCHPAY_BASE_URL=
