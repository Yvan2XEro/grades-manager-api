# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<your-secret-here>
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_COOKIE_SECURE=false
BETTER_AUTH_COOKIE_SAMESITE=lax

# ─── Database ─────────────────────────────────────────────────────────────────
# For local dev with in-memory DB (no PostgreSQL required):
USE_PGLITE=true
PGLITE_DATA_DIR=./data/pglite

# For production or local PostgreSQL:
# USE_PGLITE=false
# DATABASE_URL=postgresql://user:password@localhost:5432/tkams_secondary

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=no-reply@tkams.com

# ─── URLs (used in email templates) ──────────────────────────────────────────
# Public URL of the marketing website — logo is served from here
WEBSITE_URL=https://tkams.com
# Public URL of this app — used for CTA buttons in emails
APP_URL=https://secondary.tkams.com

# ─── System admin (super-admin backoffice) ────────────────────────────────────
# Email of the first super-admin user created by the seed script
SYSTEM_ADMIN_EMAIL=admin@tkams.io
SYSTEM_ADMIN_PASSWORD=change-me-in-production
