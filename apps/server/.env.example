# ─── Core ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DATABASE_URL=
STORAGE_DRIVER=local
BETTER_AUTH_COOKIE_SECURE=true
BETTER_AUTH_COOKIE_SAMESITE=none
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_LOCAL_PUBLIC_PATH=/uploads
SERVER_PUBLIC_URL=http://localhost:3000

# ─── Email ─────────────────────────────────────────────────────────────────────
# Sender address for all transactional emails
EMAIL_FROM=noreply@example.com

# Option A — Resend (used when RESEND_API_KEY is set)
RESEND_API_KEY=re_...

# Option B — SMTP via nodemailer (fallback when RESEND_API_KEY is not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
