VITE_SERVER_URL=
# Default organization slug to use when not running on a subdomain (e.g., localhost)
# This slug must match an organization in Better Auth
VITE_DEFAULT_ORGANIZATION_SLUG=inses-institution
# Set to "true" to use HashRouter instead of BrowserRouter.
# Useful when deploying without server-side routing support.
# In the combined image (Dockerfile.full) this is optional — Hono handles the SPA catch-all.
VITE_USE_HASH_ROUTER=false
