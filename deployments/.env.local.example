APP_URL=http://192.168.1.10
APP_PORT=80

IMAGE_TAG=latest

POSTGRES_USER=tkams
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tkams

# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-chars-minimum

DEFAULT_ORGANIZATION_SLUG=my-university

EMAIL_FROM=noreply@local.lan
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Seed ──────────────────────────────────────────────────────────────────────
# Set to false after first boot
RUN_SEED=true

# Option A: YAML files mounted from ./seeds/
# Place your files in deployments/seeds/ then set the paths below.
# Takes priority over Option B.
SEED_FOUNDATION=/seeds/00-foundation.yaml
SEED_ACADEMICS=/seeds/10-academics.yaml
SEED_USERS=/seeds/20-users.yaml

# Option B: auto-generate a minimal seed from these env vars.
# Used only when SEED_FOUNDATION above is empty.
SEED_ORG_NAME=
SEED_ORG_SLUG=
SEED_ORG_TYPE=university
SEED_ORG_COUNTRY=CM
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
