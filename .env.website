# Copy to .env and fill in secrets before deploying
# cp .env.website .env

# Payload CMS — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Dokploy — get API key from Dokploy UI → Settings → API Keys
DOKPLOY_URL=https://deploy.tkams.com
DOKPLOY_API_KEY=

# Image deployed for each client instance
DOKPLOY_APP_IMAGE=ghcr.io/yvan2xero/tkams:latest

# NotchPay
NOTCHPAY_PUBLIC_KEY=pk_...
NOTCHPAY_HASH_KEY=

